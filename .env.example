# ─────────────────────────────────────────────────────────────
# Google Calendar  (obligatorio para que las reservas se guarden)
# ─────────────────────────────────────────────────────────────
# ID del calendario del santuario. En Google Calendar:
# Configuración del calendario → Integrar calendario → "ID del calendario".
# Suele ser algo como: xxxxxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# Credenciales de la cuenta de servicio de Google (ver README).
GOOGLE_CLIENT_EMAIL=reservas-santuario@mi-proyecto.iam.gserviceaccount.com
# La clave privada del JSON, con los saltos de línea escapados como \n,
# o el mismo bloque PEM codificado en base64.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────
# Santuario  (todo opcional: si no se define, se usa el valor por defecto)
# ─────────────────────────────────────────────────────────────
SANTUARIO_NOMBRE="Santuario de Schoenstatt"
SANTUARIO_TIMEZONE="America/Argentina/Buenos_Aires"

# Los espacios que se pueden reservar, como "id:Nombre" separados por comas.
# Cada uno tiene su disponibilidad propia: dos personas pueden reservar el mismo
# horario en lugares distintos. El id es interno (sin espacios ni acentos) y no
# se debería cambiar una vez que hay reservas cargadas; el nombre es el que ve
# la gente y se puede cambiar cuando quieras.
SANTUARIO_LUGARES=santuario:Santuario,sum:SUM,cocina:Cocina

SANTUARIO_APERTURA_HORA=8          # desde qué hora se puede reservar
SANTUARIO_CIERRE_HORA=22           # hasta qué hora
SANTUARIO_PASO_MINUTOS=30          # cada cuánto cae un horario (30 = en punto y y media)
# No hay tope de duración: se puede reservar desde media hora hasta el día entero.
# El límite real es el horario de apertura y cierre, que además impide cruzar de un día
# al otro. Para acortar el rango reservable, moveme esas dos horas.
SANTUARIO_MAX_DIAS=90              # con cuánta anticipación máxima se reserva
SANTUARIO_ANTICIPACION_MINUTOS=60  # anticipación mínima para reservar hoy
SANTUARIO_DIAS_CERRADOS=           # días sin reservas: 0=domingo ... 6=sábado (ej: 1,2)
SANTUARIO_CONTACTO=                # WhatsApp que se muestra si algo falla

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API  (opcional: sólo para la respuesta automática)
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=                    # token permanente de la app de Meta
WHATSAPP_PHONE_NUMBER_ID=          # ID del número, no el número en sí
WHATSAPP_VERIFY_TOKEN=             # lo inventás vos; se pega igual en Meta
WHATSAPP_APP_SECRET=               # "App Secret" de la app de Meta (valida la firma)
WHATSAPP_API_VERSION=v22.0
WHATSAPP_VENTANA_HORAS=12          # cada cuánto se le puede repetir el link a la misma persona
RESERVAS_URL=                      # URL pública del sitio (ej: https://reservas-santuario.vercel.app)
# Texto del mensaje automático. {link} y {santuario} se reemplazan solos.
WHATSAPP_MENSAJE_BIENVENIDA=

# ─────────────────────────────────────────────────────────────
# Desarrollo
# ─────────────────────────────────────────────────────────────
# Si faltan las credenciales de Google, la página entra sola en modo demostración:
# muestra todo libre, avisa con un cartel y no guarda nada. Se apaga automáticamente
# en cuanto las credenciales están cargadas.
# Poner 1 acá fuerza la demostración aunque el calendario esté conectado (útil para
# probar sin ensuciar la agenda real).
RESERVAS_MODO_DEMO=0
